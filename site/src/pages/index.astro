---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import GuideCard from '../components/GuideCard.astro';
import '../styles/home.css';
import catalogData from '../generated/catalog-enriched.json';
import {
  GOAL_CATEGORIES,
  START_HERE_PATHS,
  ECOSYSTEM_SHORT_NAMES,
  getApproachabilityRank,
} from '../lib/goals';
import {
  buildOrganizationSchema,
  buildWebSiteSchema,
  ORGANIZATION_ID,
  SITE_ORIGIN,
  WEBSITE_ID,
} from '../lib/schema';
import type { EcosystemCategory, EnrichedGuide } from '../types/guide';

interface CatalogPayload {
  categories: EcosystemCategory[];
  guides: EnrichedGuide[];
  stats: {
    totalGuides: number;
    totalPages: number;
    totalEcosystems: number;
  };
}

const catalog = catalogData as CatalogPayload;
const { categories, guides, stats } = catalog;

const sortedGuides = [...guides].sort(
  (a, b) => getApproachabilityRank(a) - getApproachabilityRank(b),
);
const ecoCounts = new Map<string, number>();
for (const g of sortedGuides) {
  ecoCounts.set(g.ecosystem, (ecoCounts.get(g.ecosystem) ?? 0) + 1);
}

const guidesById = new Map<string, EnrichedGuide>(sortedGuides.map((g) => [g.id, g]));
const featuredGuide = guidesById.get('claude/claude-meetings') ?? guides[0];

const startHereItems = START_HERE_PATHS.map((entry) => ({
  ...entry,
  guide: guidesById.get(entry.id),
})).filter((item): item is { id: string; pathwayTitle: string; rationale: string; guide: EnrichedGuide } =>
  Boolean(item.guide),
);

const homeDescription =
  'Twelve Pages publishes clear, visual 12-page handbooks for modern software, AI studios, coding workflows, and creative tools — free to read online or download as a printable PDF.';

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    buildOrganizationSchema(),
    buildWebSiteSchema(homeDescription),
    {
      '@type': 'CollectionPage',
      name: `Twelve Pages — ${stats.totalGuides} Visual 12-Page Handbooks`,
      url: SITE_ORIGIN,
      description: homeDescription,
      inLanguage: 'en-US',
      numberOfItems: stats.totalGuides,
      isPartOf: { '@id': WEBSITE_ID },
      publisher: { '@id': ORGANIZATION_ID },
    },
  ],
};
---

<BaseLayout
  title={`Twelve Pages — ${stats.totalGuides} Visual 12-Page Handbooks You Can Read in Minutes`}
  description={homeDescription}
  ogImage="/og-default.png"
  ogImageAlt="Twelve Pages — Visual 12-page handbooks you can read online or save as a printable PDF"
  ogImageWidth={1200}
  ogImageHeight={630}
  pageType="home"
  jsonLd={homeJsonLd}
>
  <SiteHeader totalGuides={stats.totalGuides} />

  <main id="main-content">
    <section class="hero-section" aria-labelledby="hero-heading">
      <div class="shell hero-grid">
        <div class="hero-copy">
          <h1 id="hero-heading" class="hero-title">
            Clear, visual <span class="nowrap">12-page</span> handbooks you can read in minutes.
          </h1>
          <p class="hero-subtitle">
            Step-by-step illustrated editions for modern tools, creative studios, coding, and
            workflows. Read right in your browser on a phone, tablet, or laptop, or save any
            <span class="nowrap">12-page</span> magazine PDF in one click.
          </p>
          <div class="hero-actions">
            <a href="#start-here" class="btn-primary">Start Here</a>
            <a href="#library" class="btn-secondary">Browse All Handbooks</a>
          </div>
          <ul class="hero-facts meta-flow" aria-label="Library overview">
            <li class="tabular">{stats.totalGuides} Handbooks</li>
            <li class="tabular">{stats.totalPages} Illustrated Pages</li>
            <li>Read Online or Save PDF</li>
          </ul>
        </div>

        {
          featuredGuide && (
            <aside class="featured-card" aria-labelledby="featured-heading">
              <div class="featured-layout">
                <a
                  href={featuredGuide.url}
                  class="featured-cover-link"
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <img
                    class="book-cover featured-cover"
                    src={featuredGuide.coverWebpUrl}
                    alt=""
                    width={featuredGuide.coverWidth}
                    height={featuredGuide.coverHeight}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    style={`aspect-ratio: ${featuredGuide.coverWidth} / ${featuredGuide.coverHeight};`}
                  />
                </a>

                <div class="featured-body">
                  <h2 id="featured-heading" class="featured-title">
                    <a href={featuredGuide.url}>{featuredGuide.title}</a>
                  </h2>
                  <p class="featured-desc">{featuredGuide.subtitle}</p>

                  <div class="featured-badge-row">
                    <span class="badge-new">Featured new release</span>
                  </div>

                  <div class="featured-meta meta-flow">
                    <span>{featuredGuide.ecosystemShort}</span>
                    <span class="tabular">{featuredGuide.pages} pages</span>
                    <span class="tabular">{featuredGuide.readingMinutes} min read</span>
                  </div>

                  <div class="featured-actions">
                    <a href={featuredGuide.url} class="btn-primary">
                      <span>Read Online</span>
                      <svg
                        aria-hidden="true"
                        width="16"
                        height="16"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                      </svg>
                    </a>
                    <a
                      href={featuredGuide.pdfUrl}
                      download={featuredGuide.pdfFilename}
                      class="btn-secondary"
                    >
                      <svg
                        aria-hidden="true"
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <polyline points="7 10 12 15 17 10" />
                        <line x1="12" y1="15" x2="12" y2="3" />
                      </svg>
                      <span>
                        Download PDF <span class="tabular">({featuredGuide.pdfSizeLabel})</span>
                      </span>
                    </a>
                  </div>
                </div>
              </div>
            </aside>
          )
        }
      </div>
    </section>

    <section id="start-here" class="start-section" aria-labelledby="start-here-heading">
      <div class="shell">
        <div class="section-header">
          <h2 id="start-here-heading" class="section-title">Start here</h2>
          <p class="section-lead">
            Three approachable starting points designed to give you a useful result in under 15
            minutes.
          </p>
        </div>

        <div class="start-grid">
          {
            startHereItems.map((item) => (
              <article class="start-card pathway-card">
                <div class="start-card-head">
                  <a href={item.guide.url} tabindex="-1" aria-hidden="true">
                    <img
                      class="book-cover start-cover"
                      src={item.guide.coverWebpUrl}
                      alt=""
                      width={item.guide.coverWidth}
                      height={item.guide.coverHeight}
                      loading="eager"
                      decoding="async"
                      style={`aspect-ratio: ${item.guide.coverWidth} / ${item.guide.coverHeight};`}
                    />
                  </a>
                  <div class="start-head-text">
                    <h3 class="start-card-title">
                      <a href={item.guide.url}>{item.pathwayTitle}</a>
                    </h3>
                    <p class="start-card-book">{item.guide.title}</p>
                  </div>
                </div>

                <p class="start-card-rationale">{item.rationale}</p>

                <div class="start-card-meta meta-flow">
                  <span>{item.guide.ecosystemShort}</span>
                  <span class="tabular">{item.guide.pages} pages</span>
                  <span class="tabular">PDF {item.guide.pdfSizeLabel}</span>
                </div>

                <div class="start-card-footer pathway-card-footer">
                  <a href={item.guide.url} class="guide-read-link">
                    <span>Read Online</span>
                    <svg
                      aria-hidden="true"
                      width="15"
                      height="15"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14" />
                      <path d="m12 5 7 7-7 7" />
                    </svg>
                  </a>
                  <a
                    href={item.guide.pdfUrl}
                    download={item.guide.pdfFilename}
                    class="guide-pdf-btn"
                  >
                    <svg
                      aria-hidden="true"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                      <polyline points="7 10 12 15 17 10" />
                      <line x1="12" y1="15" x2="12" y2="3" />
                    </svg>
                    <span>Download PDF</span>
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section id="library" class="library-section" aria-labelledby="library-heading">
      <div class="shell">
        <div class="section-header">
          <h2 id="library-heading" class="section-title">Explore all handbooks</h2>
          <p class="section-lead">
            Filter by what you want to do, pick a topic, or type a word below to find the right
            guide. <a href="/topics" class="topics-index-link">Browse all {stats.totalEcosystems} topic hubs</a>.
          </p>
        </div>

        <search class="explorer-controls" aria-label="Search and filter handbooks">
          <div class="search-field">
            <label for="guide-search" class="sr-only">Search handbooks</label>
            <svg
              class="search-icon"
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input
              id="guide-search"
              type="search"
              autocomplete="off"
              spellcheck="false"
              aria-describedby="search-shortcut-hint"
              placeholder="Search handbooks (meetings, slides, notes)..."
            />
            <span id="search-shortcut-hint" class="sr-only">Press / to search.</span>
            <span id="search-kbd" class="search-kbd" aria-hidden="true">Press <kbd>/</kbd> to search</span>
            <button id="search-clear" type="button" class="search-clear" aria-label="Clear search" hidden>
              <svg
                aria-hidden="true"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
              </svg>
            </button>
          </div>

          <div class="filter-group filter-group--goals" role="group" aria-labelledby="goal-filter-label">
            <span id="goal-filter-label" class="filter-label">By goal</span>
            <div class="filter-pills-col">
              <div class="filter-pills">
                <button
                  type="button"
                  class="filter-pill"
                  data-filter-goal="all"
                  data-goal-desc="Showing handbooks for every goal — pick one above to narrow the shelf."
                  aria-pressed="true"
                >
                  All goals
                </button>
                {
                  GOAL_CATEGORIES.map((goal) => (
                    <button
                      type="button"
                      class="filter-pill"
                      data-filter-goal={goal.id}
                      data-goal-desc={goal.description}
                      aria-pressed="false"
                    >
                      {goal.label}
                    </button>
                  ))
                }
              </div>
              <p id="goal-helper" class="goal-helper">
                Showing handbooks for every goal — pick one above to narrow the shelf.
              </p>
            </div>
          </div>

          <div id="ecosystems" class="filter-group filter-group--topic">
            <label for="topic-select" class="filter-label">By topic</label>
            <div class="topic-select-row">
              <div class="select-wrap">
                <select id="topic-select" class="topic-select">
                  <option value="all" data-base-label={`All ${categories.length} topics`}>
                    All {categories.length} topics ({stats.totalGuides})
                  </option>
                  {
                    categories.map((cat) => {
                      const shortName = ECOSYSTEM_SHORT_NAMES[cat.id] || cat.shortTitle || cat.title;
                      const count = ecoCounts.get(cat.id) ?? 0;
                      return (
                        <option value={cat.id} data-base-label={shortName}>
                          {shortName} ({count})
                        </option>
                      );
                    })
                  }
                </select>
                <svg
                  class="select-chevron"
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </div>
              <a href="/topics" class="topic-hub-link">All topic hubs</a>
            </div>
          </div>
        </search>

        <div class="results-bar">
          <p id="results-count" class="results-count tabular" aria-live="polite">
            Showing {stats.totalGuides} of {stats.totalGuides} handbooks
          </p>
          <button id="active-reset" type="button" class="reset-link" hidden>Reset filters</button>
        </div>

        <div id="bookshelf-grid" class="bookshelf-grid">
          {sortedGuides.map((guide, idx) => <GuideCard guide={guide} eager={idx < 4} />)}
        </div>

        <div id="show-all-wrap" class="show-all-wrap" hidden>
          <button id="show-all-guides" type="button" class="btn-secondary">
            <span>Show all <span class="tabular">{stats.totalGuides}</span> handbooks</span>
          </button>
        </div>

        <div id="empty-state" class="empty-state" hidden>
          <div class="empty-icon" aria-hidden="true">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
          </div>
          <h3 class="empty-title">No handbooks match those filters</h3>
          <p id="empty-state-detail" class="empty-detail" hidden></p>
          <p class="empty-desc">
            Try switching back to all topics or searching with a simpler word like meetings, notes,
            or video.
          </p>
          <button id="empty-reset" type="button" class="btn-primary">Reset filters</button>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter totalGuides={stats.totalGuides} totalEcosystems={stats.totalEcosystems} />
</BaseLayout>

<script>
  const INITIAL_CAP = 16;

  const searchInput = document.getElementById('guide-search') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const searchKbd = document.getElementById('search-kbd') as HTMLElement | null;
  const goalHelper = document.getElementById('goal-helper') as HTMLParagraphElement | null;
  const topicSelect = document.getElementById('topic-select') as HTMLSelectElement | null;
  const resultsCount = document.getElementById('results-count') as HTMLParagraphElement | null;
  const activeReset = document.getElementById('active-reset') as HTMLButtonElement | null;
  const emptyReset = document.getElementById('empty-reset') as HTMLButtonElement | null;
  const showAllWrap = document.getElementById('show-all-wrap') as HTMLElement | null;
  const showAllBtn = document.getElementById('show-all-guides') as HTMLButtonElement | null;
  const grid = document.getElementById('bookshelf-grid') as HTMLElement | null;
  const emptyState = document.getElementById('empty-state') as HTMLElement | null;
  const emptyStateDetail = document.getElementById('empty-state-detail') as HTMLParagraphElement | null;

  const goalButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-filter-goal]'),
  );
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.guide-card'));

  const validGoals = new Set(goalButtons.map((btn) => btn.dataset.filterGoal || 'all'));
  const validEcos = new Set(
    topicSelect ? Array.from(topicSelect.options).map((opt) => opt.value) : ['all'],
  );

  let showAllExpanded = false;

  const state = {
    goal: 'all',
    eco: 'all',
    q: '',
  };

  function readQueryParams() {
    const params = new URLSearchParams(window.location.search);
    const goal = params.get('goal');
    const eco = params.get('eco');
    const q = params.get('q');

    if (goal && validGoals.has(goal)) state.goal = goal;
    if (eco && validEcos.has(eco)) state.eco = eco;
    if (q) state.q = q.trim();

    if (searchInput) searchInput.value = state.q;
    if (topicSelect) topicSelect.value = state.eco;
  }

  function syncUrl() {
    const params = new URLSearchParams();
    if (state.goal !== 'all') params.set('goal', state.goal);
    if (state.eco !== 'all') params.set('eco', state.eco);
    if (state.q.length > 0) params.set('q', state.q);

    const query = params.toString();
    const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash}`;
    window.history.replaceState(null, '', nextUrl);
  }

  function applyFilters(updateUrl = true) {
    const tokens = state.q
      .toLowerCase()
      .split(/\s+/)
      .filter(Boolean);

    const hasQuery = state.q.length > 0;
    const isFiltered = state.goal !== 'all' || state.eco !== 'all' || hasQuery;

    const ecoMatchCounts = new Map<string, number>();
    let totalGoalSearchMatches = 0;
    const matchingCards: HTMLElement[] = [];

    for (const card of cards) {
      const cardGoals = (card.dataset.goals || '').split(',').filter(Boolean);
      const cardEco = card.dataset.eco || '';
      const cardSearch = card.dataset.search || '';

      const matchesGoal = state.goal === 'all' || cardGoals.includes(state.goal);
      const matchesEco = state.eco === 'all' || cardEco === state.eco;
      const matchesSearch =
        tokens.length === 0 || tokens.every((token) => cardSearch.includes(token));

      if (matchesGoal && matchesSearch) {
        totalGoalSearchMatches += 1;
        ecoMatchCounts.set(cardEco, (ecoMatchCounts.get(cardEco) ?? 0) + 1);
      }

      if (matchesGoal && matchesEco && matchesSearch) {
        matchingCards.push(card);
      }
    }

    const shouldCap = !isFiltered && !showAllExpanded && matchingCards.length > INITIAL_CAP;
    const visibleCards = shouldCap ? matchingCards.slice(0, INITIAL_CAP) : matchingCards;
    const visibleSet = new Set(visibleCards);

    for (const card of cards) {
      card.hidden = !visibleSet.has(card);
    }

    const visibleCount = visibleSet.size;

    let activeGoalDesc = '';
    for (const btn of goalButtons) {
      const btnGoal = btn.dataset.filterGoal || 'all';
      const isActive = btnGoal === state.goal;
      btn.setAttribute('aria-pressed', String(isActive));
      if (isActive) {
        activeGoalDesc = btn.dataset.goalDesc || '';
      }
    }
    if (goalHelper && activeGoalDesc) {
      goalHelper.textContent = activeGoalDesc;
    }

    if (topicSelect) {
      for (const option of Array.from(topicSelect.options)) {
        const val = option.value;
        const baseLabel = option.dataset.baseLabel || val;
        if (val === 'all') {
          option.textContent = `${baseLabel} (${totalGoalSearchMatches})`;
          option.disabled = false;
        } else {
          const count = ecoMatchCounts.get(val) ?? 0;
          option.textContent = `${baseLabel} (${count})`;
          option.disabled = count === 0 && val !== state.eco;
        }
      }
      if (topicSelect.value !== state.eco) {
        topicSelect.value = state.eco;
      }
    }

    if (searchClear) searchClear.hidden = !hasQuery;
    if (searchKbd) searchKbd.hidden = hasQuery;

    if (showAllWrap) showAllWrap.hidden = !shouldCap;
    if (showAllBtn) showAllBtn.hidden = !shouldCap;

    if (activeReset) activeReset.hidden = !isFiltered || visibleCount === 0;

    if (resultsCount) {
      const total = cards.length;
      resultsCount.textContent = `Showing ${visibleCount} of ${total} ${total === 1 ? 'handbook' : 'handbooks'}`;
    }

    if (grid) grid.hidden = visibleCount === 0;
    if (emptyState) emptyState.hidden = visibleCount > 0;

    if (emptyStateDetail) {
      if (visibleCount === 0) {
        const parts: string[] = [];
        if (state.goal !== 'all') {
          const activeGoalBtn = goalButtons.find((b) => b.dataset.filterGoal === state.goal);
          const goalLabel = activeGoalBtn?.textContent?.trim() || state.goal;
          parts.push(`goal "${goalLabel}"`);
        }
        if (state.eco !== 'all' && topicSelect) {
          const activeOpt = Array.from(topicSelect.options).find((o) => o.value === state.eco);
          const ecoLabel = activeOpt?.dataset.baseLabel || state.eco;
          parts.push(`topic "${ecoLabel}"`);
        }
        if (hasQuery) {
          parts.push(`search "${state.q}"`);
        }
        emptyStateDetail.textContent =
          parts.length > 0
            ? `Active filters (${parts.join(' + ')}) returned 0 handbooks.`
            : '0 handbooks matched your selection.';
        emptyStateDetail.hidden = false;
      } else {
        emptyStateDetail.textContent = '';
        emptyStateDetail.hidden = true;
      }
    }

    if (updateUrl) syncUrl();
  }

  function resetAllFilters() {
    state.goal = 'all';
    state.eco = 'all';
    state.q = '';
    if (searchInput) searchInput.value = '';
    if (topicSelect) topicSelect.value = 'all';
    applyFilters(true);
  }

  for (const btn of goalButtons) {
    btn.addEventListener('click', () => {
      state.goal = btn.dataset.filterGoal || 'all';
      applyFilters(true);
    });
  }

  topicSelect?.addEventListener('change', () => {
    state.eco = topicSelect.value || 'all';
    applyFilters(true);
  });

  searchInput?.addEventListener('input', () => {
    state.q = searchInput.value.trim();
    applyFilters(true);
  });

  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchInput.value.length > 0) {
      event.preventDefault();
      state.q = '';
      searchInput.value = '';
      applyFilters(true);
    }
  });

  searchClear?.addEventListener('click', () => {
    state.q = '';
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
    }
    applyFilters(true);
  });

  showAllBtn?.addEventListener('click', (event) => {
    showAllExpanded = true;
    applyFilters(false);
    if (event.detail === 0) {
      cards[INITIAL_CAP]?.querySelector<HTMLAnchorElement>('.guide-card-title a')?.focus();
    }
  });

  activeReset?.addEventListener('click', resetAllFilters);
  emptyReset?.addEventListener('click', resetAllFilters);

  document.addEventListener('keydown', (event) => {
    if (event.key !== '/' || event.metaKey || event.ctrlKey || event.altKey) return;
    const active = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const tag = active ? active.tagName.toLowerCase() : '';
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || active?.isContentEditable) {
      return;
    }
    event.preventDefault();
    searchInput?.focus();
  });

  readQueryParams();
  applyFilters(false);
</script>

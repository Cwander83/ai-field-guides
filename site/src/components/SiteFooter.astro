---
export interface Props {
  totalGuides?: number;
  totalEcosystems?: number;
}

const { totalGuides = 77, totalEcosystems = 10 } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-top">
      <div class="footer-copy">
        <div class="footer-brand">
          <svg
            class="footer-mark"
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 32 32"
            fill="none"
          >
            <rect x="6.5" y="3.5" width="21.5" height="25.5" rx="4.5" fill="currentColor"></rect>
            <rect x="3" y="3" width="21.5" height="25.5" rx="4.5" fill="var(--bg-surface)" stroke="var(--ink-main)" stroke-width="1.5"></rect>
            <rect x="6.5" y="6.5" width="14.5" height="2" rx="1" fill="currentColor"></rect>
            <path d="M7.6 14.4 L9.6 12.8 V23.4 M7.6 23.4 H11.6" stroke="var(--ink-main)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M14.1 15.2 C14.1 13.4 15.5 12.6 17.3 12.6 C19.1 12.6 20.4 13.7 20.4 15.3 C20.4 16.9 19.1 18.1 17.1 19.8 L14.0 22.5 V23.4 H20.6" stroke="var(--ink-main)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="footer-title">Twelve Pages</span>
        </div>
        <p class="footer-desc">
          <span class="tabular">{totalGuides}</span> illustrated 12-page handbooks across <span class="tabular">{totalEcosystems}</span> topics.
          Read online on any phone or laptop, or download the print-ready magazine PDF in one click — no account required.
        </p>
      </div>

      <nav class="footer-links" aria-label="Footer navigation">
        <a href="/#library">All Handbooks</a>
        <a href="/topics">Topics</a>
        <a href="/editorial">Editorial &amp; AI Disclosure</a>
        <a href="/rss.xml">RSS Feed</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <button type="button" class="footer-pref-btn" data-open-cookie-prefs>
          Cookie Preferences
        </button>
        <a href="#main-content">Back to top</a>
      </nav>
    </div>

    <p class="footer-colophon">
      Articles, topic pages, diagrams, and illustrations on Twelve Pages are generated with AI under human editorial direction and print-layout QA. Independent publication — not affiliated with, endorsed by, or sponsored by Google, Anthropic, OpenAI, Vercel, Obsidian, or any software vendor featured.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: var(--bg-subtle);
    border-top: 1px solid var(--border-hair);
  }

  .site-footer-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 2.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }

  .footer-copy {
    max-width: 54ch;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .footer-mark {
    color: var(--accent);
    flex-shrink: 0;
  }

  .footer-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--ink-main);
  }

  .footer-desc {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.125rem;
    padding-top: 0.25rem;
    max-width: 460px;
  }

  .footer-links a,
  .footer-pref-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid transparent;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    padding: 0.25rem 0;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1.4;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .footer-links a:hover,
  .footer-pref-btn:hover {
    color: var(--ink-main);
    border-bottom-color: var(--ink-muted);
  }

  .footer-pref-btn {
    color: var(--ink-main);
    border-bottom-color: var(--ink-muted);
  }

  .footer-colophon {
    margin: 0;
    max-width: var(--measure);
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-hair);
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--ink-muted);
  }

  @media (max-width: 720px), (pointer: coarse) {
    .footer-links a,
    .footer-pref-btn {
      min-height: 44px;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      margin-top: 3rem;
    }

    .site-footer-inner {
      padding: 2rem 1rem 2.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-links a,
    .footer-pref-btn {
      transition: opacity 0.1s linear;
    }
  }
</style>

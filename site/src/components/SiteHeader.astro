---
export interface Props {
  totalGuides?: number;
}

const { totalGuides = 77 } = Astro.props;
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="brand-link">
      <svg
        class="brand-mark"
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 32 32"
        fill="none"
      >
        <rect x="6.5" y="3.5" width="21.5" height="25.5" rx="4.5" fill="currentColor"></rect>
        <rect x="3" y="3" width="21.5" height="25.5" rx="4.5" fill="#FAF8F4" stroke="#181714" stroke-width="1.5"></rect>
        <rect x="6.5" y="6.5" width="14.5" height="2" rx="1" fill="currentColor"></rect>
        <path d="M7.6 14.4 L9.6 12.8 V23.4 M7.6 23.4 H11.6" stroke="#181714" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        <path d="M14.1 15.2 C14.1 13.4 15.5 12.6 17.3 12.6 C19.1 12.6 20.4 13.7 20.4 15.3 C20.4 16.9 19.1 18.1 17.1 19.8 L14.0 22.5 V23.4 H20.6" stroke="#181714" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span class="brand-name">Twelve Pages</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      <a href="/#library" class="nav-link">
        All <span class="tabular">{totalGuides}</span> Handbooks
      </a>
      <a href="/#start-here" class="nav-link">Start Here</a>
      <a href="/topics" class="nav-link">Topics</a>
      <a href="/editorial" class="nav-link">How It&rsquo;s Made</a>
      <a href="/guides/claude/claude-meetings" class="nav-cta">Claude Meetings</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--bg-page);
    border-bottom: 1px solid var(--border-hair);
  }

  .site-header-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    color: var(--ink-main);
    padding: 0.25rem 0;
    border-radius: 6px;
  }

  .brand-mark {
    color: var(--accent);
    flex-shrink: 0;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.25rem;
  }

  .nav-link {
    color: var(--ink-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.375rem 0.125rem;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--ink-main);
    border-bottom-color: var(--ink-muted);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.9375rem;
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid var(--accent);
    border-radius: 7px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .nav-cta:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 720px) {
    .site-header-inner {
      padding: 0.75rem 1rem;
      gap: 0.625rem;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.45rem 0.75rem;
      padding-top: 0.375rem;
      border-top: 1px solid var(--border-hair);
    }

    .nav-link {
      font-size: 0.875rem;
    }

    .nav-cta {
      min-height: 36px;
      padding: 0.4375rem 0.75rem;
      font-size: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link,
    .nav-cta {
      transition: opacity 0.1s linear;
    }
  }
</style>

---
---

<aside
  id="cookie-consent-bar"
  class="cookie-bar"
  aria-label="Cookie preferences"
  hidden
>
  <div class="cookie-bar-inner">
    <div class="cookie-copy">
      <p class="cookie-text">
        Optional Google Analytics cookies run only with your consent; reading preferences stay cookie-free.
        <a href="/privacy" class="cookie-link">Privacy Notice</a>
      </p>
      <p id="cookie-gpc-note" class="cookie-gpc-note" hidden>
        Global Privacy Control (GPC) is active in your browser — optional analytics cookies remain off.
      </p>
    </div>

    <div class="cookie-actions">
      <button type="button" id="cookie-decline" class="cookie-btn cookie-btn--secondary">
        Decline Optional
      </button>
      <button type="button" id="cookie-accept" class="cookie-btn cookie-btn--primary">
        Accept Cookies
      </button>
    </div>
  </div>
</aside>

<style>
  .cookie-bar[hidden],
  .cookie-gpc-note[hidden] {
    display: none !important;
  }

  .cookie-bar {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-hair);
    color: var(--ink-main);
  }

  .cookie-bar-inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  .cookie-copy {
    flex: 1 1 320px;
    min-width: 0;
  }

  .cookie-text {
    margin: 0;
    font-size: 0.84375rem;
    line-height: 1.45;
    color: var(--ink-main);
  }

  .cookie-link {
    color: var(--accent-hover);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 0.35rem;
    white-space: nowrap;
  }

  .cookie-link:hover {
    color: var(--accent);
  }

  .cookie-gpc-note {
    margin: 0.25rem 0 0;
    font-size: 0.78125rem;
    font-weight: 600;
    color: var(--accent-hover);
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .cookie-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.4375rem 0.9375rem;
    border-radius: 7px;
    font-family: var(--font-body);
    font-size: 0.84375rem;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .cookie-btn--secondary {
    background: var(--bg-page);
    color: var(--ink-main);
    border: 1px solid var(--border-hair);
  }

  .cookie-btn--secondary:hover {
    background: var(--bg-subtle);
    border-color: var(--ink-muted);
  }

  .cookie-btn--primary {
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid var(--accent);
  }

  .cookie-btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  @media (max-width: 720px), (pointer: coarse) {
    .cookie-btn {
      min-height: 44px;
    }
  }

  @media (max-width: 640px) {
    .cookie-bar-inner {
      padding: 0.625rem 0.875rem;
      gap: 0.5rem;
    }

    .cookie-text {
      font-size: 0.8125rem;
      line-height: 1.4;
    }

    .cookie-link {
      display: inline-block;
      padding-block: 0.25rem;
    }

    .cookie-actions {
      width: 100%;
    }

    .cookie-btn {
      flex: 1 1 0;
      min-height: 44px;
      padding: 0.5rem 0.75rem;
      font-size: 0.84375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-btn {
      transition: opacity 0.1s linear;
    }
  }
</style>

<script>
  type GtagFn = (...args: unknown[]) => void;

  function getGtag(): GtagFn | undefined {
    return (window as unknown as { gtag?: GtagFn }).gtag;
  }

  function isGpcEnabled(): boolean {
    return (navigator as unknown as { globalPrivacyControl?: boolean }).globalPrivacyControl === true;
  }

  function clearGaCookies(): void {
    const raw = document.cookie || '';
    if (!raw) return;
    const host = window.location.hostname;
    const domains = Array.from(
      new Set(['', host, host ? `.${host}` : '', '.twelve-pages.com']),
    );
    const secureVariants = window.location.protocol === 'https:' ? ['', '; Secure'] : [''];
    for (const part of raw.split(';')) {
      const eqIdx = part.indexOf('=');
      const name = (eqIdx >= 0 ? part.slice(0, eqIdx) : part).trim();
      if (
        !name.startsWith('_ga') &&
        !name.startsWith('_gid') &&
        !name.startsWith('_gat')
      ) {
        continue;
      }
      for (const domain of domains) {
        const domainAttr = domain ? `; domain=${domain}` : '';
        for (const secureAttr of secureVariants) {
          document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/${domainAttr}; SameSite=Lax${secureAttr}`;
        }
      }
    }
  }

  const bar = document.getElementById('cookie-consent-bar');
  const gpcNote = document.getElementById('cookie-gpc-note');
  const acceptBtn = document.getElementById('cookie-accept') as HTMLButtonElement | null;
  const declineBtn = document.getElementById('cookie-decline') as HTMLButtonElement | null;

  if (bar && acceptBtn && declineBtn) {
    const gpc = isGpcEnabled();
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('tp-consent');
    } catch {
      saved = null;
    }
    let lastTrigger: HTMLElement | null = null;

    const syncCookieClearance = (): void => {
      if (bar.hidden) {
        document.documentElement.style.removeProperty('--cookie-bar-clearance');
        return;
      }
      const height = bar.getBoundingClientRect().height;
      if (height > 0) {
        document.documentElement.style.setProperty(
          '--cookie-bar-clearance',
          `${Math.ceil(height + 24)}px`,
        );
      }
    };

    if (gpc) {
      clearGaCookies();
      bar.hidden = true;
    } else if (saved === 'granted' || saved === 'denied') {
      if (saved === 'denied') clearGaCookies();
      bar.hidden = true;
    } else {
      bar.hidden = false;
    }
    syncCookieClearance();

    if (typeof ResizeObserver !== 'undefined') {
      const clearanceObserver = new ResizeObserver(() => {
        syncCookieClearance();
      });
      clearanceObserver.observe(bar);
    }
    window.addEventListener('resize', syncCookieClearance, { passive: true });

    const hideBarAndRestoreFocus = (): void => {
      bar.hidden = true;
      syncCookieClearance();
      lastTrigger?.focus();
      lastTrigger = null;
    };

    acceptBtn.addEventListener('click', () => {
      if (isGpcEnabled()) {
        clearGaCookies();
        if (gpcNote) gpcNote.hidden = false;
        syncCookieClearance();
        return;
      }
      try {
        localStorage.setItem('tp-consent', 'granted');
      } catch {
        /* Storage may be unavailable */
      }
      saved = 'granted';
      getGtag()?.('consent', 'update', { analytics_storage: 'granted' });
      hideBarAndRestoreFocus();
    });

    declineBtn.addEventListener('click', () => {
      try {
        localStorage.setItem('tp-consent', 'denied');
      } catch {
        /* Storage may be unavailable */
      }
      saved = 'denied';
      getGtag()?.('consent', 'update', { analytics_storage: 'denied' });
      clearGaCookies();
      hideBarAndRestoreFocus();
    });

    bar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (saved !== 'granted' && saved !== 'denied' && !isGpcEnabled()) return;
      event.preventDefault();
      hideBarAndRestoreFocus();
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('[data-open-cookie-prefs]');
      if (!trigger) return;
      lastTrigger = trigger instanceof HTMLElement ? trigger : null;
      if (gpcNote) {
        gpcNote.hidden = !isGpcEnabled();
      }
      bar.hidden = false;
      syncCookieClearance();
      declineBtn.focus();
    });
  }
</script>

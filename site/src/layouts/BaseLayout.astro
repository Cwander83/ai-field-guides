---
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/tokens.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  pageType?: 'home' | 'reader' | 'topic' | 'legal' | 'error';
  markdownUrl?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Clear, visual 12-page handbooks for modern tools, creative studios, coding, and workflows — free to read online or download as a printable PDF.',
  ogImage = '/og-default.png',
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  pageType = 'home',
  markdownUrl,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL('https://twelve-pages.com');
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath !== '/' ? rawPath.replace(/\/+$/, '') : '/';
const canonicalUrl = new URL(normalizedPath, siteOrigin).toString();
const shouldIndex = pageType !== 'error' && !noindex;
const resolvedOgImage =
  ogImage.startsWith('http://') || ogImage.startsWith('https://')
    ? ogImage
    : new URL(ogImage, siteOrigin).toString();
const resolvedMarkdownUrl = markdownUrl
  ? new URL(markdownUrl, siteOrigin).toString()
  : null;
---

<!doctype html>
<html lang="en" data-paper="warm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF8F4" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Twelve Pages — Visual 12-Page Handbooks"
      href={new URL('/rss.xml', siteOrigin).toString()}
    />
    <link
      rel="alternate"
      type="application/feed+json"
      title="Twelve Pages — JSON Feed"
      href={new URL('/feed.json', siteOrigin).toString()}
    />
    {
      resolvedMarkdownUrl && (
        <link
          rel="alternate"
          type="text/markdown"
          href={resolvedMarkdownUrl}
          title={`${title} (Markdown)`}
        />
      )
    }

    {
      shouldIndex ? (
        <>
          <link rel="canonical" href={canonicalUrl} />
          <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1"
          />
        </>
      ) : (
        <meta name="robots" content="noindex, follow" />
      )
    }

    <meta property="og:site_name" content="Twelve Pages" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={pageType === 'reader' ? 'article' : 'website'} />
    {shouldIndex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={resolvedOgImage} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <script is:inline>
      (function () {
        try {
          var saved =
            localStorage.getItem('tp-paper') || localStorage.getItem('afg-paper');
          var isValid = saved === 'warm' || saved === 'white' || saved === 'sepia';
          document.documentElement.dataset.paper = isValid ? saved : 'warm';
        } catch (_err) {
          document.documentElement.dataset.paper = 'warm';
        }
      })();
    </script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      (function () {
        var gpc = navigator.globalPrivacyControl === true;
        var saved = null;
        try {
          saved = localStorage.getItem('tp-consent');
        } catch (_err) {}
        var granted = !gpc && saved === 'granted';
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: granted ? 'granted' : 'denied',
          security_storage: 'granted',
          wait_for_update: 500,
        });
        gtag('set', 'ads_data_redaction', true);
        gtag('set', 'url_passthrough', false);
        gtag('js', new Date());
        var s = document.createElement('script');
        s.async = true;
        s.fetchPriority = 'low';
        s.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-WBBHXC7S';
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body data-page={pageType}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <CookieBanner />
  </body>
</html>
